PORT=8000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Provider AI: 'auto' | 'gemini' | 'anthropic'
AI_PROVIDER=auto

# Konfigurasi Google Gemini (Rekomendasi - kuota gratis tersedia)
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Konfigurasi Anthropic Claude (Opsional / Alternatif)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Google Safe Browsing API Key (Opsional)
SAFE_BROWSING_API_KEY=
