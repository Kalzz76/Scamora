PORT=8000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Provider AI: 'auto' | 'gemini' | 'anthropic'
AI_PROVIDER=auto

# Konfigurasi Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Konfigurasi Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Google Safe Browsing API Key (Opsional)
SAFE_BROWSING_API_KEY=

# Database Connection (PostgreSQL Lokal atau Supabase Direct Connection)
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/scamora
DATABASE_URL=

# Supabase (Opsional - jika menggunakan Supabase JS client)
SUPABASE_URL=
SUPABASE_KEY=

# Kredensial Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=scamora-super-secret-admin-key-2026
