# ==========================================
# Scamora Backend - Environment Variables
# ==========================================

# Server Configuration
PORT=8000
NODE_ENV=production

# URL Frontend Scamora yang telah di-host di Vercel (untuk CORS & OAuth Redirect)
# Contoh: https://scamora-frontend.vercel.app
FRONTEND_ORIGIN=https://<YOUR_FRONTEND_VERCEL_URL>

# Provider AI: 'auto' | 'gemini' | 'anthropic'
AI_PROVIDER=gemini

# Masukkan Gemini API Key dari Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Opsional: Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Opsional: Google Safe Browsing API Key (https://developers.google.com/safe-browsing)
SAFE_BROWSING_API_KEY=

# Supabase PostgreSQL Connection URL (Pooler Transaction/Session Mode)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Contoh: postgresql://postgres.<project_ref>:<db_password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase REST Client
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Kredensial Administrator Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=scamora-super-secret-admin-key-2026

# Google OAuth 2.0 (Opsional - untuk login SSO pengguna via Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://<YOUR_BACKEND_VERCEL_URL>/api/v1/auth/google/callback
