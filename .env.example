# ==============================================================================
# Scamora Platform - Master Environment Template (.env.example)
# ==============================================================================
# Proyek Scamora memiliki beberapa sub-layanan:
# 1. backend/   -> Salin konfigurasi backend ke `backend/.env`
# 2. frontend/  -> Salin konfigurasi frontend ke `frontend/.env`
# 3. admin/     -> Salin konfigurasi admin ke `admin/.env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (backend/.env)
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Provider AI: 'auto' | 'gemini' | 'anthropic'
AI_PROVIDER=auto

# Masukkan Gemini API Key dari Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Opsional: Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Opsional: Google Safe Browsing API Key (https://developers.google.com/safe-browsing)
SAFE_BROWSING_API_KEY=

# Database PostgreSQL Lokal (atau Supabase connection string)
# Format: postgresql://username:password@localhost:5432/scamora
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/scamora

# Supabase (Opsional - jika menggunakan Supabase JS client)
SUPABASE_URL=
SUPABASE_KEY=

# Kredensial Administrator Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=scamora-super-secret-admin-key-2026

# Google OAuth 2.0 (Opsional - untuk login SSO pengguna via Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (frontend/.env)
# ------------------------------------------------------------------------------
# Set ke 'false' untuk menggunakan backend nyata, 'true' untuk mode simulasi mock
VITE_USE_MOCK=false

# Endpoint backend Scamora API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 3. ADMIN PANEL (admin/.env)
# ------------------------------------------------------------------------------
# Endpoint backend Scamora Admin API
VITE_API_BASE_URL=http://localhost:8000/api/v1/admin
VITE_USE_MOCK=false
